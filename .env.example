# Usado pelo docker-compose.yml. Copie para .env e não versione os valores reais.
# As credenciais abaixo são de desenvolvimento e coincidem com backend/.env.example.
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
# Pelo menos 32 caracteres. Gere com: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=gere-uma-chave-aleatoria-longa
# Porta da API no computador. Mude se a 8000 já estiver em uso por outro projeto
# e ajuste API_PROXY_TARGET em frontend/.env para a mesma porta.
API_PORT=8001
